{
  "animatedParts" : {
    "stateTypes" : {
      "default" : {
        "default" : "default",
        "states" : {
          "default" : { "frames" : 8, "cycle" : 1, "mode" : "loop" }
        }
      }
    },

    "parts" : {
      "bg" : {
        "properties" : {
          "centered" : false
        },

        "partStates" : {
          "default" : {
            "default" : {
              "properties" : {
                "image" : "<partImage>:<color>.<frame>",
				"fullbright" : true
              }
            }
          }
        }
      },
      "fg" : {
        "properties" : {
          "centered" : false,
          "zLevel" : 1
        },

        "partStates" : {
          "default" : {
            "default" : {
              "properties" : {
                "image" : "<partImage>:<color>.<frame>"
              }
            }
          }
        }
      }
    }
  }
}
